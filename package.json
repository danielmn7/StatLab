{
  "name": "statlab",
  "version": "1.2.1",
  "description": "StatLab — Scientific statistics & figures (desktop app)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/check.js && node tests/prism.check.js && node tests/ui.check.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "author": "StatLab",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.statlab.desktop",
    "productName": "StatLab",
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "StatLab-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StatLab"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
